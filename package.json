{
  "name": "@fleeksite/cli",
  "version": "0.1.0",
  "description": "Keep a FleekSite site's code in git, and deploy static app builds to FleekSite.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fleek": "dist/main.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fleeksite/cli.git"
  },
  "homepage": "https://github.com/fleeksite/cli#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fleek": "tsx src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
